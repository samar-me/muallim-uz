# Telegram Bot token (@BotFather orqali olinadi)
BOT_TOKEN=your_telegram_bot_token_here

# AI Provayder: "gemini" yoki "openai"
AI_PROVIDER=gemini

# AI API kaliti (Google AI Studio yoki OpenAI platformasidan olinadi)
AI_API_KEY=your_gemini_or_openai_api_key_here

# Gemini model nomi (agar AI_PROVIDER=gemini bo'lsa)
GEMINI_MODEL=gemini-1.5-flash

# OpenAI model nomi (agar AI_PROVIDER=openai bo'lsa)
OPENAI_MODEL=gpt-4o-mini
