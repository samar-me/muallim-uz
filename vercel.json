{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "public/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/health",
      "destination": "/api/index.js"
    },
    {
      "source": "/muallim_logo.jpg",
      "destination": "/api/index.js"
    },
    {
      "source": "/muallim_banner.jpg",
      "destination": "/api/index.js"
    }
  ]
}